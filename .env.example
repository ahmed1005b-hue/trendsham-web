APP_NAME=TrendSham
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Damascus
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trendsham
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="supporttrendsham@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="supporttrendsham@gmail.com"
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# بوابة الرسائل النصية (OTP) — راجع config/sms.php
SMS_DRIVER=log
# twilio = SMS عادية | twilio_whatsapp = رسالة واتساب
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ===== الدفع الإلكتروني وتحويل أرباح البائعين — راجع config/payment.php =====
# PAYMENT_DRIVER: manual (بدون دفع إلكتروني) | sandbox (بنك تجريبي للاختبار) | bank (البنك الحقيقي)
PAYMENT_DRIVER=manual
PAYMENT_CURRENCY=SYP
# عند استلام مفاتيح البنك:
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_WEBHOOK_SECRET=
# المسارات وأسماء الحقول (TODO(BANK): طابقها مع وثائق البنك — القيم الافتراضية في config/payment.php)
# PAYMENT_GATEWAY_CHECKOUT_PATH=/checkout
# PAYMENT_GATEWAY_CARD_SAVE_PATH=/cards/tokenize
# PAYMENT_GATEWAY_CARD_CHARGE_PATH=/charges
# PAYMENT_GATEWAY_AMOUNT_MINOR=true

# PAYOUT_DRIVER: manual (المدير يحوّل ويسجّل رقم الحوالة) | sandbox | bank (API تحويلات البنك)
PAYOUT_DRIVER=manual
PAYOUT_MIN_AMOUNT=10000
PAYOUT_REQUIRE_VERIFIED_METHOD=false
# PAYOUT_GATEWAY_URL=
# PAYOUT_GATEWAY_KEY=
# PAYOUT_GATEWAY_PATH=/payouts

# مساعد خدمة العملاء الذكي (Claude API) — احصل على المفتاح من console.anthropic.com
ANTHROPIC_API_KEY=
# Launch security: require HTTPS in production (APP_URL=https://...) and terminate TLS at the server/proxy.
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=your-domain.com

FIREBASE_CREDENTIALS=storage/app/private/firebase-credentials.json
FIREBASE_PROJECT_ID=trendsham-6900c
